# ── Site ────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://www.example.com
# Set to "false" on preview/staging deployments to disallow indexing.
PUBLIC_ALLOW_INDEXING=true

# ── Sanity (content) ────────────────────────────────────────────────────
# Leave PUBLIC_SANITY_PROJECT_ID empty to run on bundled sample content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-09-01
# Only needed for a private dataset. Viewer token; server-side only.
SANITY_API_READ_TOKEN=

# ── Contact form: Resend (email) ────────────────────────────────────────
RESEND_API_KEY=
# Comma-separated inbox(es) that receive enquiries
CONTACT_TO_EMAIL=sales@example.com
# Must be on a domain verified in Resend
CONTACT_FROM_EMAIL=SKT Website <website@example.com>

# ── Contact form: Google Sheets (lead log) ──────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks, in double quotes
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Enquiries

# ── Contact form: spam protection ───────────────────────────────────────
# Any long random string (e.g. `openssl rand -hex 32`). Keeps form tokens
# valid across server restarts and multiple instances.
CONTACT_FORM_SECRET=
